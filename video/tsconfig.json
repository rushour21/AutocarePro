{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "react",
      "node"
    ],
    "paths": {
      "@/*": [
        "../*"
      ]
    }
  },
  "include": [
    "src",
    "remotion.config.ts",
    "tailwind.config.ts"
  ]
}